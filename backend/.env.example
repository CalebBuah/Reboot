PORT=5000
NODE_ENV=development
DB_PATH=./reboot.db
SESSION_TTL_MS=86400000
RESET_TOKEN_TTL_MS=3600000
COOKIE_SECURE=false
ESP32_API_TOKEN=replace-with-a-long-random-device-token
APP_BASE_URL=http://localhost:5000

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-16-character-google-app-password
MAIL_FROM=your-gmail-address@gmail.com

HEARTBEAT_TIMEOUT_MS=35000
HEARTBEAT_INTERVAL_MS=30000
RELAY_DURATION_MS=10000
RELAY_OFF_GRACE_MS=5000
PING_INTERVAL_MS=30000
PING_TARGET=8.8.8.8
FAILURE_THRESHOLD=3
RESTART_LIMIT_PER_HOUR=5
RESTART_HOUR_WINDOW_MS=3600000

CORS_ORIGIN=http://localhost:5000,http://localhost:3000,http://127.0.0.1:5000,http://localhost:5500,http://127.0.0.1:5500
